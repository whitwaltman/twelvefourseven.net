{
  "name": "home",
  "version": "1.0.0",
  "main": ".eleventy.js",
  "scripts": {
    "build": "npx eleventy",
    "build:all": "npm run clean && npm run build && npm run format",
    "clean": "rm -rf _site",
    "debug": "DEBUG=* npx eleventy",
    "format": "node _utils/format.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "npx eleventy --serve --incremental",
    "serve": "npx eleventy --serve",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.md": [
      "node _utils/updated.js",
      "git add _data/gitUpdated.json"
    ]
  },
  "keywords": [],
  "author": "whitwaltman",
  "license": "ISC",
  "description": "",
  "repository": {
    "type": "git",
    "origin": "git@github.alt:whitwaltman/twelvefourseven.net.git"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.0"
  },
  "devDependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "linkedom": "^0.18.12",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.1"
  },
  "type": "module"
}
