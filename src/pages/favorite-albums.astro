---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const metadata = await getEntry('garden', 'favorite-albums');
const albums = await getCollection('albums');
---

<BaseLayout pageTitle={metadata.data.title}>
    Note that this doesn't include soundtracks!
    {albums.map((album) => (
        <div data-album={album.id}>
            <span>Title: {album.data.title}</span>
            <span>Artist: {album.data.artist}</span>
            <span>Released: {album.data.release}</span>
            <span>Length: {album.data.length} minutes</span>
        </div>
    ))}
</BaseLayout>