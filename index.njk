<h2>table of contents</h2>
<ul class="toc">
{% for page in collections.all %}
    {% if page.url !== "/" %}
    <li class="toc__item">
        <a class="toc__link" href="{{ page.url }}">{{ page.fileSlug }}</a>
        <p class="toc__description">{{ page.data.preview | trim }}</p>
    </li>
    {% endif %}
{% endfor %}
</ul>

<img src="/img/me.jpg" alt="pic of me"/>