<h2>table of contents</h2>
<ul class="index">
{% for page in collections.all %}
    {% if page.url !== "/" %}
    <li class="index__item">
        <a class="index__link" href="{{ page.url }}">{{ page.fileSlug }}</a>
        <p class="index__description">{{ page.data.preview }}</p>
    </li>
    {% endif %}
{% endfor %}
</ul>

<img src="/img/me.jpg" alt="pic of me"/>

