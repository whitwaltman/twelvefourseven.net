<h2 class="f3 lh-copy fw5">Table of contents</h2>
<ul class="toc list pa0">
{% for page in collections.all %}
    {% if page.url !== "/" %}
    <li class="">
        <a class="link" href="{{ page.url }}">{{ page.fileSlug }}</a>
        <p class="dib">{{ page.data.preview | trim }}</p>
    </li>
    {% endif %}
{% endfor %}
</ul>

<img src="/img/me.jpg" alt="pic of me"/>