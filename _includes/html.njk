<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="{{ eleventy.generator }}">
    {% if title %}
        {% set sep = " | "%}
    {% endif %}
    <title>{{ title }}{{ sep }}{{ site.title }}</title>
    <meta
      name="description"
      content="{{ preview | default(site.description) }}"/>
    <meta property="og:url" content="https://twelvefourseven.net">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.title }}">
    <meta property="og:description" content="{{ preview | default(site.description) }}">
    {% if isProduction %}
        {% set css %}{% include "public/css/base.css" %}{% endset %}
        <style>
            {{ css | safe }}
        </style>
    {% else %}
        <link rel="stylesheet" href="/css/base.css"/>
    {% endif %}
</head>
<body>
    {{ content | safe }}
</body>
</html>